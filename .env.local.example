GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Postgres connection string, e.g.:
#   postgres://user:password@localhost:5432/multiagent
DATABASE_URL=your_postgres_connection_string_here

# Set to "false" only for a local Postgres with no SSL. Most managed
# providers (Neon, Supabase, Render, RDS) need SSL, which is the default.
DATABASE_SSL=true

# Any long random string - used to sign login sessions.
# Generate one with: openssl rand -base64 32
JWT_SECRET=your_random_jwt_secret_here
